{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist/server",
    // comment out rootDir to enable cross workspace imports
    "rootDir": "./src",
    "composite": true,
    "noEmit": false // Create JS files from TS files
  },
  "include": ["src"],
  // Test files are run directly with tsx, so they are kept out of the build
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
